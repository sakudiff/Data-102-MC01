    "# INSIGHTS
# Consolidated evidence supporting the insights narrative:
#   Panel A - variance decomposition across the nested model sequence
#   Panel B - tuition elasticity by sector, unadjusted vs adjusted
#   Panel C - practical translation of elasticities into dollars at sector medians

# Panel A: how much each block of predictors adds
variance_ladder = pd.DataFrame({
    "Specification": ["Model 1: tuition only",
                      "Model 2: + sector and interaction",
                      "Model 3: + enrollment, degree, state"],
    "R-squared": [model1.rsquared, model2.rsquared, model3.rsquared],
    "Adjusted R-squared": [model1.rsquared_adj, model2.rsquared_adj, model3.rsquared_adj],
    "Log RMSE": [np.sqrt(np.mean(np.square(m.resid))) for m in (model1, model2, model3)],
})
variance_ladder["Gain in R-squared"] = variance_ladder["R-squared"].diff().fillna(
    variance_ladder["R-squared"].iloc[0]
)
variance_ladder = variance_ladder.set_index("Specification").round(4)

print("PANEL A: Variance explained across the nested model sequence")
display(variance_ladder)
print(f"Unexplained variation remaining in Model 3: {1 - model3.rsquared:.1%}\n")

# Panel B: elasticities side by side
elasticity_comparison = pd.DataFrame({
    "Model 2 (unadjusted)": model2_slopes["Tuition elasticity"],
    "Model 3 (adjusted)": model3_slopes["Tuition elasticity"],
})
elasticity_comparison["Change"] = (
    elasticity_comparison["Model 3 (adjusted)"] - elasticity_comparison["Model 2 (unadjusted)"]
)
elasticity_comparison["Percent of Model 2 slope retained"] = (
    elasticity_comparison["Model 3 (adjusted)"] / elasticity_comparison["Model 2 (unadjusted)"] * 100
).round(1)

print("PANEL B: Tuition elasticity before and after institutional controls")
display(elasticity_comparison.round(4))

# Panel C: elasticity expressed in dollars at each sector's own median
sector_medians = df_cleaned.groupby("CONTROL_LABEL")[["TUITIONFEE_IN", "MD_EARN_WNE_P10"]].median()
practical = sector_medians.loc[order].copy()
practical.columns = ["Median tuition", "Median earnings"]
practical["Adjusted elasticity"] = model3_slopes["Tuition elasticity"]
practical["Earnings gain per $1,000 tuition"] = (
    practical["Adjusted elasticity"] * (1000 / practical["Median tuition"]) * practical["Median earnings"]
)

practical_display = practical.copy().astype(object)
for col in ["Median tuition", "Median earnings", "Earnings gain per $1,000 tuition"]:
    practical_display[col] = practical[col].map(lambda v: f"${v:,.0f}")
practical_display["Adjusted elasticity"] = practical["Adjusted elasticity"].round(4)

print("\nPANEL C: Elasticities translated to dollars at sector medians")
display(practical_display)

# Visualization: variance ladder and dollar-return translation
fig, axes = plt.subplots(1, 2, figsize=(14, 5.5))

ladder_labels = ["Tuition only", "+ Sector and interaction", "+ Institutional controls"]
increments = variance_ladder["Gain in R-squared"].to_numpy() * 100
ladder_colors = ["#2E45B8", "#1DC9A4", "#C91D42"]

bottom = 0
for label, increment, color in zip(ladder_labels, increments, ladder_colors):
    axes[0].bar("Model 3", increment, bottom=bottom, color=color, edgecolor="white",
                linewidth=0.8, label=label, width=0.5)
    axes[0].text(0, bottom + increment / 2, f"{increment:.1f} pts",
                 ha="center", va="center", fontsize=10, fontweight="bold", color="white")
    bottom += increment

axes[0].bar("Model 3", 100 - bottom, bottom=bottom, color="#E8E8E8", edgecolor="white",
            linewidth=0.8, label="Unexplained", width=0.5)
axes[0].text(0, bottom + (100 - bottom) / 2, f"{100 - bottom:.1f} pts",
             ha="center", va="center", fontsize=10, fontweight="bold", color="#333333")
axes[0].set_ylim(0, 100)
axes[0].set_ylabel("Share of variation in log earnings, %")
axes[0].set_xlabel("")
axes[0].set_xticks([])
axes[0].set_title("Sector and institutional structure explain more\nthan tuition alone",
                  fontsize=12, fontweight="bold")
axes[0].legend(frameon=False, fontsize=9, loc="upper right")
axes[0].spines["top"].set_visible(False)
axes[0].spines["right"].set_visible(False)

returns = practical["Earnings gain per $1,000 tuition"]
bars = axes[1].bar(order, [returns[g] for g in order],
                   color=[q1_colors[g] for g in order], edgecolor="white", linewidth=0.8)
for bar, value in zip(bars, [returns[g] for g in order]):
    axes[1].text(bar.get_x() + bar.get_width() / 2, bar.get_height() + 20,
                 f"${value:,.0f}", ha="center", va="bottom", fontsize=10, fontweight="bold")
axes[1].set_title("Public institutions convert marginal tuition\ninto earnings most efficiently",
                  fontsize=12, fontweight="bold")
axes[1].set_xlabel("Institution control type")
axes[1].set_ylabel("Associated earnings gain per $1,000 tuition, $")
axes[1].spines["top"].set_visible(False)
axes[1].spines["right"].set_visible(False)

plt.tight_layout(pad=2)
plt.show()
