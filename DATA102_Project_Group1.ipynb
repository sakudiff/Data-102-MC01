    "        sector_data[\"TUITIONFEE_IN\"].min(),\n",
    "        sector_data[\"TUITIONFEE_IN\"].max(),\n",
    "        100,\n",
    "    )\n",
    "    prediction_data = pd.DataFrame(\n",
    "        {\n",
    "            \"log_tuition\": np.log(tuition_grid),\n",
